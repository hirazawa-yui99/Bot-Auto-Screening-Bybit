[Unit]
Description=Bybit Quant Bot v9.1
After=network.target postgresql.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/bybit_quant_v9
ExecStart=/home/ubuntu/bybit_quant_v9/venv/bin/python main.py
Restart=always
RestartSec=10
StandardOutput=append:/var/log/bybit_bot.log
StandardError=append:/var/log/bybit_bot.err

[Install]
WantedBy=multi-user.target